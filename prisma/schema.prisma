generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  category     String
  location     String
  type         String // fulltime | contract | freelance | internship
  description  String
  requirements String
  isOpen       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id             String   @id @default(cuid())
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id])
  fullName       String
  email          String
  phone          String
  currentSalary  String?
  expectedSalary String?
  resumePath     String // Supabase Storage object path
  portfolioUrl   String?
  coverLetter    String?
  source         String?
  status         String   @default("new") // new | interview | offering | accepted | rejected
  aiScore        Int?
  aiSummary      String?
  aiAnalysis     String?  @db.Text
  createdAt      DateTime @default(now())

  @@unique([email, jobId])
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}
